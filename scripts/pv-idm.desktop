[Desktop Entry]
Name=PV-IDM
GenericName=Internet Download Manager
Comment=High-performance segmented download manager with browser integration
Exec=pv-idm-gui %U
Icon=pv-idm
Terminal=false
Type=Application
Categories=Network;FileTransfer;P2P;
MimeType=x-scheme-handler/idm;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=pv-idm
Actions=AddUrl;StartQueue;StopAll;

[Desktop Action AddUrl]
Name=Add URL to PV-IDM
Exec=pv-idm-gui

[Desktop Action StartQueue]
Name=Start Download Queue
Exec=pv-idm queue start

[Desktop Action StopAll]
Name=Stop All Downloads
Exec=pv-idm queue stop
